// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen {
        zmk,underglow = &led_strip;
    };
};

&led_strip {
    chain-length = <20>;
};

#define DEFAULT 0
#define LOWER   1
#define RAISE   2


/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sl 1>, <&sl 2>, <&sl 3>;
        };

        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <150>;
        };
    };

    macros {
        macro_1: macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&kp H &kp E &kp L &kp L &kp O>;
        };
    
    clt: custom_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &clt RAISE LOWER  &kp KP_LPAR  &kp KP_RPAR   &kp KP_DIVIDE
                &kp KP_N7         &kp KP_N8    &kp KP_N9     &kp KP_MULTIPLY
                &kp KP_N4         &kp KP_N5    &kp KP_N6     &kp KP_MINUS
                &kp KP_N1         &kp KP_N2    &kp KP_N3     &kp KP_PLUS
                &kp KP_N0         &kp KP_DOT   &kp COMMA     &kp KP_ENTER
            >;
	    sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_msc SCRL_LEFT SCRL_RIGHT>;
        };

        macro_layer {
            bindings = <
                &to DEFAULT    &none   &none    &none
                &none          &none   &none    &none
                &none          &none   &none    &none
                &none          &none   &none    &none
                &none          &none   &none    &macro_1
            >;
        };

        fn_layer {
            bindings = <
                &to 0             &out OUT_TOG      &studio_unlock    &bootloader
                &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_CLR
                &rgb_ug RGB_HUI   &rgb_ug RGB_HUI   &rgb_ug RGB_BRI   &rgb_ug RGB_BRD
                &rgb_ug RGB_SAI   &rgb_ug RGB_SAD   &rgb_ug RGB_SPI   &rgb_ug RGB_SPD
                &rgb_ug RGB_EFF   &rgb_ug RGB_TOG   &none             &sys_reset
            >;
        };
    };
};
