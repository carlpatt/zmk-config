// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2

&led_strip {
    chain-length = <20>;
};

/ {
    behaviors {
        clt: custom_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&to>;
        };

        inc_dec_msc: inc_dec_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <150>;
        };

        dot_comma: dot_comma {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>; /* <Hold, Tap> */
        };
    };

    macros {
        /* Teams Push to Talk: 
            - Press: Sends Ctrl+Shift+M (Unmute)
            - Hold: Pauses execution while button is held
            - Release: Sends Ctrl+Shift+M (Mute)
        */
        teams_ptt: teams_ptt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                /* 1. Unmute on press */
                = <&macro_press &kp LCTRL &kp LSHFT &kp M>
                , <&macro_release &kp LCTRL &kp LSHFT &kp M>
                /* 2. Wait while holding */
                , <&macro_pause_for_release>
                /* 3. Mute on release */
                , <&macro_press &kp LCTRL &kp LSHFT &kp M>
                , <&macro_release &kp LCTRL &kp LSHFT &kp M>;
        };
        
        /* Type "ssh root@" and paste IP (Shift + Insert) */
        ssh_root: ssh_root {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings
                = <&macro_tap &kp S &kp S &kp H &kp SPACE &kp R &kp O &kp O &kp T &kp AT &kp LS(INS)>;
        };
    };

/*
 * =========================================================================
 * ZMK DIRECT MODIFIER KEYCODE REFERENCE
 * =========================================================================
 *
 * TEAMS SHORTCUTS
 *   &kp LC(LS(M))     - Toggle Mute             (Ctrl + Shift + M)
 *   &kp LC(LS(K))     - Raise / Lower Hand      (Ctrl + Shift + K)
 *   &kp LC(LS(O))     - Toggle Camera           (Ctrl + Shift + O)
 *
 * VS CODE SHORTCUTS
 *   &kp LC(P)         - Quick Open File         (Ctrl + P)
 *   &kp LC(LS(P))     - Command Palette         (Ctrl + Shift + P)
 *   &kp LC(LS(O))     - Go to Symbol in File    (Ctrl + Shift + O)
 *   &kp LC(LS(F))     - Global Search           (Ctrl + Shift + F)
 *   &kp LC(LS(R))     - Refactor                (Ctrl + Shift + R)
 *   &kp LC(GRAVE)     - Toggle Terminal         (Ctrl + `)
 *   &kp LA(LS(UP))    - Duplicate Line Above    (Alt + Shift + Up)
 *   &kp LA(LS(DOWN))  - Duplicate Line Below    (Alt + Shift + Down)
 *
 * NAVIGATION / TABS
 *   &kp LC(TAB)       - Next Tab                (Ctrl + Tab)
 *   &kp LC(LS(TAB))   - Previous Tab            (Ctrl + Shift + Tab)
 *
 * MODIFIER CODES:
 *   LC(code) = Left Control | LS(code) = Left Shift | LA(code) = Left Alt
 * =========================================================================
 */
    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp C_MUTE   &kp C_PP
                &kp KP_NUM   &kp KP_LPAR  &kp KP_RPAR                   &kp KP_DIVIDE
                &kp KP_N7    &kp KP_N8    &kp KP_N9                     &kp KP_MULTIPLY
                &kp KP_N4    &kp KP_N5    &kp KP_N6                     &kp KP_MINUS
                &kp KP_N1    &kp KP_N2    &kp KP_N3                     &kp KP_PLUS
                &clt 2 1     &kp KP_N0    &dot_comma KP_COMMA KP_DOT    &kp KP_ENTER
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_msc SCRL_RIGHT SCRL_LEFT>;
        };

        macro_layer {
            bindings = <
                &none          &kp LC(N0)
                &teams_ptt     &kp LC(LS(M))        &kp LC(LS(K))     &kp LC(LS(O))
                &kp LC(P)      &kp LC(LS(O))        &kp LC(LS(R))     &kp LC(LS(P))
                &kp LC(GRAVE)  &kp LC(LS(GRAVE))    &kp LA(LS(UP))    &kp LA(LS(DOWN))
                &none          &none                &none             &none
                &to 0          &ssh_root            &none             &none
            >;
            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB)) &inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
        };

        fn_layer {
            bindings = <
                &none             &none
                &sys_reset        &out OUT_TOG      &studio_unlock    &bootloader
                &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_CLR
                &rgb_ug RGB_HUI   &rgb_ug RGB_HUD   &rgb_ug RGB_BRI   &rgb_ug RGB_BRD
                &rgb_ug RGB_SAI   &rgb_ug RGB_SAD   &rgb_ug RGB_SPI   &rgb_ug RGB_SPD
                &to 0             &rgb_ug RGB_TOG   &rgb_ug RGB_EFF   &none
            >;
        };
    };
};
